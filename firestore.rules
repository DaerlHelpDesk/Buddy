rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    /* ================= USERS ================= */
    match /users/{userId} {
      allow create: if signedIn();
      allow read, update: if signedIn() && request.auth.uid == userId;
    }

    /* ================= TASKERS ================= */
    match /taskers/{taskerId} {
      allow create: if signedIn() && request.auth.uid == taskerId;
      allow read: if signedIn();
      allow update: if signedIn() && request.auth.uid == taskerId;
    }

    /* ================= TASKS ================= */
    match /tasks/{taskId} {
      allow read, create: if signedIn();

      allow update: if signedIn()
        && (
          resource.data.status == "open" ||
          request.auth.uid == resource.data.userId ||
          request.auth.uid == resource.data.taskerId
        );
    }

    /* ================= CHATS ================= */
    match /chats/{chatId} {
      allow create: if signedIn();
      allow read, update: if signedIn()
        && request.auth.uid in resource.data.participants;
    }

    match /chats/{chatId}/messages/{messageId} {
      allow read, create: if signedIn();
    }
  }
}
